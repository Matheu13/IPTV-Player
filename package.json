{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "diagnose": "tsx scripts/milestone0_diagnose.ts",
    "test:m1": "tsx scripts/milestone1_tests.ts",
    "test:m2": "tsx scripts/milestone2_tests.ts",
    "test:m3": "tsx scripts/milestone3_tests.ts",
    "test:phase3": "tsx scripts/phase3_automated_tests.ts",
    "test:category-hierarchy": "tsx scripts/validate_category_hierarchy.ts",
    "test:all": "tsx scripts/milestone1_tests.ts && tsx scripts/milestone2_tests.ts && tsx scripts/milestone3_tests.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mpegts.js": "^1.8.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
